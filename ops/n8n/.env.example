# Copy to .env on the OCI host only. Never commit the populated file.
N8N_IMAGE_TAG=<pin-an-tested-n8n-version>
N8N_HOST=n8n.example.invalid
N8N_ENCRYPTION_KEY=<generate-and-store-a-long-random-secret>
GITHUB_WEBHOOK_SECRET=<store-the-webhook-secret-on-the-server-only>
GENERIC_TIMEZONE=Europe/Berlin
