# Copy to .env on the OCI host only. Never commit the populated file.
N8N_IMAGE_TAG=<pin-an-tested-n8n-version>
N8N_HOST=n8n.example.invalid
N8N_ENCRYPTION_KEY=<generate-and-store-a-long-random-secret>
GITHUB_WEBHOOK_SECRET=<store-the-webhook-secret-on-the-server-only>
GITHUB_EXPECTED_REPOSITORY=LaurentLE9/Studien-lernplan-app
ROUTER_SHARED_SECRET=<generate-and-store-a-long-random-internal-secret>
# Optional cheap-model provider. Leave all five values empty to fail closed to Codex.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_INPUT_EUR_PER_MILLION_TOKENS=
LLM_OUTPUT_EUR_PER_MILLION_TOKENS=
LLM_MAX_OUTPUT_TOKENS=512
LLM_TIMEOUT_MS=15000
GENERIC_TIMEZONE=Europe/Berlin
