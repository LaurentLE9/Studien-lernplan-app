{
  "name": "KAN-131 – Minimalberechtigte Integrationsprobe",
  "nodes": [
    {
      "parameters": {},
      "id": "kan131-manual-trigger",
      "name": "Manuell starten",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            { "name": "githubExpectedRepository", "value": "LaurentLE9/Studien-lernplan-app" },
            { "name": "jiraApiBaseUrl", "value": "https://api.atlassian.com/ex/jira/<cloud-id>/rest/api/3" },
            { "name": "jiraProbeIssueKey", "value": "KAN-131" },
            { "name": "confluenceApiBaseUrl", "value": "https://<site>.atlassian.net/wiki/api/v2" },
            { "name": "confluenceProbePageId", "value": "<existing-page-id>" },
            { "name": "supabaseTestRestUrl", "value": "https://<project-ref>.supabase.co/rest/v1" }
          ]
        },
        "options": {}
      },
      "id": "kan131-probe-config",
      "name": "Probe-Konfiguration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.github.com/repos/{{$node[\"Probe-Konfiguration\"].json[\"githubExpectedRepository\"]}}",
        "authentication": "none",
        "options": {}
      },
      "id": "kan131-github-read",
      "name": "GitHub Repository-Metadaten lesen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [520, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$node[\"Probe-Konfiguration\"].json[\"jiraApiBaseUrl\"] + '/issue/' + $node[\"Probe-Konfiguration\"].json[\"jiraProbeIssueKey\"]}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {}
      },
      "id": "kan131-jira-read",
      "name": "Jira-Vorgang lesen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [780, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": { "httpBasicAuth": { "name": "jiraApiToken" } }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$node[\"Probe-Konfiguration\"].json[\"confluenceApiBaseUrl\"] + '/pages/' + $node[\"Probe-Konfiguration\"].json[\"confluenceProbePageId\"]}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "options": {}
      },
      "id": "kan131-confluence-read",
      "name": "Confluence-Seite lesen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1040, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": { "httpBasicAuth": { "name": "confluenceReadOnly" } }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$node[\"Probe-Konfiguration\"].json[\"supabaseTestRestUrl\"] + '/user_plans?select=user_id&limit=1'}}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "kan131-supabase-read",
      "name": "Isolierte Supabase-Testdaten lesen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1300, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "credentials": { "httpHeaderAuth": { "name": "supabaseTestReadOnly" } }
    }
  ],
  "connections": {
    "Manuell starten": { "main": [[{ "node": "Probe-Konfiguration", "type": "main", "index": 0 }]] },
    "Probe-Konfiguration": {
      "main": [[
        { "node": "GitHub Repository-Metadaten lesen", "type": "main", "index": 0 },
        { "node": "Jira-Vorgang lesen", "type": "main", "index": 0 },
        { "node": "Confluence-Seite lesen", "type": "main", "index": 0 },
        { "node": "Isolierte Supabase-Testdaten lesen", "type": "main", "index": 0 }
      ]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "tags": []
}
